# Buddy Island Backend – Umgebungsvariablen
# Diese Datei enthält KEINE echten Werte. Echte Werte nur in Railway → Service → Variables.
# Nie in die Electron-App, nie ins Repo.

NODE_ENV=production
# Railway setzt PORT selbst
PORT=8080
# Öffentliche HTTPS-Adresse des Backends, z. B. https://api.buddy-island.top
PUBLIC_URL=
# Hinter dem Railway-Proxy: 1 (dann wird HTTPS erzwungen)
TRUST_PROXY=1
# Browser-Herkünfte, die das Backend aufrufen dürfen (die Desktop-App braucht keinen Eintrag)
CORS_ORIGINS=https://buddy-island.top
LOG_LEVEL=info

# --- Supabase (Projekt «buddy-island», Region Zürich) ---
SUPABASE_URL=https://ifbpbsbgdpnxmwtycjqr.supabase.co
# Öffentlicher Schlüssel (sb_publishable_…): Supabase → Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=
# GEHEIM. Secret Key (sb_secret_…): nur hier, nie in der App
SUPABASE_SECRET_KEY=
# Nur nötig, falls das Projekt noch alte HS256-Tokens ausstellt (Legacy JWT Secret)
SUPABASE_JWT_SECRET=

# --- Google (Desktop-Client «installed» aus der Google Cloud Console) ---
GOOGLE_CLIENT_ID=500970603959-a5cf0i68ibc91j932pn9ooeqb7l4bmn0.apps.googleusercontent.com
# GEHEIM. Client-Secret des Desktop-Clients (GOCSPX-…)
GOOGLE_CLIENT_SECRET=

# --- OpenAI (einziger Cloud-Anbieter) ---
# GEHEIM. Projekt-Key nur für Buddy Cloud, mit Ausgabenlimit im OpenAI-Dashboard
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CLOUD_DEFAULT_OUTPUT_TOKENS=4096
CLOUD_MAX_OUTPUT_TOKENS=32000
CLOUD_MAX_INPUT_TOKENS=250000
OPENAI_TIMEOUT_MS=600000

# --- Stripe ---
# GEHEIM. Erst mit sk_test_… testen, dann sk_live_…
STRIPE_SECRET_KEY=
# GEHEIM. Signing Secret des Webhook-Endpunkts (whsec_…)
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://buddy-island.top/kauf/danke
STRIPE_CANCEL_URL=https://buddy-island.top/kauf/abgebrochen

# Hinweis: Die Umrechnung CHF → Buddy Credits und USD → CHF steht NICHT hier, sondern zentral
# in der Datenbank (Tabelle public.billing_settings), damit Backend und Abrechnung exakt
# dieselben Werte nutzen. Siehe docs/cloud/BILLING.md.
